---
title: COPAS - Lutte contre les discriminations
---
<%= partial "layouts/navbar2" %>
<% f = data.formations[0] %>
<div class="ground fi">
  <div class="container">
    <header class="fi-hero">
      <span class="fi-badge"><i class="fa-solid fa-people-group"></i> Formation en inter</span>
      <h1><%= f.title %></h1>
      <p class="fi-lead"><%= f.introduction %></p>
      <ul class="fi-chips">
        <li><i class="far fa-clock"></i> <%= f.duration %></li>
        <li><i class="fa-solid fa-location-dot"></i> Lille ou Paris</li>
        <li><i class="fa-solid fa-tag"></i> <%= f.price %></li>
      </ul>
      <div class="fi-actions">
        <a href="<%= f.subscription %>" target="_blank" class="fi-btn fi-btn-primary"><i class="fa fa-download"></i> Bulletin d’inscription</a>
        <a href="/contact.html" class="fi-btn fi-btn-ghost"><i class="fa-regular fa-envelope"></i> Nous contacter</a>
      </div>
    </header>

    <div class="ground-content">
      <h2>
        Programme de formation
      </h2>
      <!-- <p>Prochaine session : <%= data.formations[0].session %> </p> -->
      <details>
        <summary>
          <div class="clk"><i class="fas fa-chevron-right"></i> Objectifs</div>
        </summary>
        <section>
          <ul>
            <% data.formations[0].goals.each do |f| %>
              <li><%= f %></li>
            <% end %>
          </ul>
        </section>
      </details>
      <details>
        <summary>
          <div class="clk"><i class="fas fa-chevron-right"></i> Public cible</div>
        </summary>
        <section>
          <%= data.formations[0].targeted_people %>
        </section>
      </details>
      <details>
        <summary>
          <div class="clk"><i class="fas fa-chevron-right"></i> Pré-requis</div>
        </summary>
        <section>
          <%= data.formations[0].prerequisites %>
        </section>
      </details>
      <details>
        <summary>
          <div class="clk"><i class="fas fa-chevron-right"></i> Mode de validation des acquis</div>
        </summary>
        <section>
          <ul>
            <% data.formations[0].validation.each do |f| %>
              <li><%= f %></li>
            <% end %>
          </ul>
        </section>
      </details>
      <details>
        <summary>
          <div class="clk"><i class="fas fa-chevron-right"></i> Moyens pédagogiques et techniques</div>
        </summary>
        <section>
          <%= data.formations[0].technology %>
        </section>
      </details>
      <details>
        <summary>
          <div class="clk"><i class="fas fa-chevron-right"></i> Mots clés</div>
        </summary>
        <section>
          <%= data.formations[0].key_words %>
        </section>
      </details>
      <!--<details>
        <summary>
          <div class="clk"><i class="fas fa-chevron-right"></i> Plaquette de formation</div>
        </summary>
        <section>
          <a href= <%= data.formations[0].leaflet %> target="_blank" class="plaquette"><i class="fa fa-download"></i> Téléchargez de la plaquette de formation</a>
        </section>
      </details> -->
      <details>
        <summary>
          <div class="clk"><i class="fas fa-chevron-right"></i> Bulletin d'inscription</div>
        </summary>
        <section>
          <a href= <%= data.formations[0].subscription %> target="_blank" class="plaquette"><i class="fa fa-download"></i> Téléchargez le bulletin d'inscription</a>
        </section>
      </details>
    </div>
  </div>
</div>

<script>
$('.clk').click(function(){
    $(this).find('i').toggleClass('fa-chevron-right fa-chevron-down')
});
</script>
