<% data.formations_intra.each do |formation| %>
  <a href="<%= formation.link %>" class="link__formation">
    <div class="formation__card">
      <div class="clk"><%= formation.title %></div>
      <div class="info-formation">
        <p class="duration-formation"><i class="far fa-clock"></i> <%= formation.duration %></p>
      </div>
    </div>
  </a>
<% end %>
<% data.intras.each do |intra| %>
  <div class="text__intra">
    <div class="intra__card">
      <div class="intra__title"><%= intra.title %></div>
      <ul>
        <% intra.formation_title.each do |f| %>
          <li><%= f %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
<p><i class="fa-solid fa-location-dot"></i> Localisation : Dans vos locaux</p>
